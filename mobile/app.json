{
  "expo": {
    "name": "Astana Issue Reporter",
    "slug": "astana-issue-reporter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kz.aitu.astanareporter"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "kz.aitu.astanareporter",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used to place the problem on the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "The camera is used to photograph the problem.",
          "photosPermission": "Choose a photo of the problem from your gallery."
        }
      ],
      "expo-notifications"
    ],
    "scheme": "astanareporter",
    "description": "Report city problems in Astana: photo, map point, category, likes and status tracking.",
    "extra": {
      "apiUrl": "https://astana-issue-reporter-api.onrender.com"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
