{
  "name": "astana-issue-reporter-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the Astana Issue Reporter mobile app (Express + PostgreSQL)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
