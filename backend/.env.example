# Copy to .env for local development. On Render these are set in the dashboard.
PORT=4000
DATABASE_URL=postgresql://app:app@localhost:5432/astana
DATABASE_SSL=false
JWT_SECRET=change-me-to-a-long-random-string
# Optional: Supabase Storage for photos (otherwise photos are saved in ./uploads)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=report-photos
# Contact email shown on /privacy and /delete-account (needed for the app stores)
CONTACT_EMAIL=
# Optional: new password for all admin accounts, applied on every start (use it before publishing to the stores)
ADMIN_PASSWORD=
